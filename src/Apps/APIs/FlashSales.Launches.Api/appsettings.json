{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": ""
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "FlashSales.Launches.Api"
    }
  },
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Authentication": {
    "Authority": "",
    "Audience": "",
    "RequireHttpsMetadata": true,
    "MetadataAddress": ""
  },
  "ServiceBus": {
    "FullyQualifiedNamespace": "",
    "ConnectionString": ""
  },
  "Jobs": {
    "ActivatorIntervalInSeconds": 30,
    "EnderIntervalInSeconds": 30
  },
  "Outbox": {
    "IntervalInSeconds": 5,
    "BatchSize": 10,
    "MaxRetryCount": 3
  },
  "Inbox": {
    "IntervalInSeconds": 5,
    "BatchSize": 10,
    "MaxRetryCount": 3
  },
  "AllowedHosts": "*"
}
