{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore.Diagnostics.HealthChecks": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": ""
        }
      }
    ]
  },
  "OpenTelemetry": {
    "Otlp": {
      "Endpoint": ""
    }
  },
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": ""
  },
  "PermissionsCache": {
    "CacheExpirationInSeconds": 900
  },
  "BlobStorage": {
    "ConnectionString": "",
    "ContainerName": ""
  },
  "Authentication": {
    "Authority": "",
    "Audience": "",
    "RequireHttpsMetadata": true,
    "MetadataAddress": ""
  },
  "Swagger": {
    "ClientId": ""
  },
  "ServiceBus": {
    "FullyQualifiedNamespace": "",
    "ConnectionString": ""
  },
  "KeyCloak": {
    "AdminUrl": "",
    "CurrentRealm": "",
    "BaseUrl": "",
    "ConfidentialClientId": "",
    "ConfidentialClientSecret": "",
    "MaxRetryAttempts": 3
  },
  "Outbox": {
    "IntervalInSeconds": 5,
    "BatchSize": 10,
    "MaxRetryCount": 3
  },
  "Inbox": {
    "IntervalInSeconds": 5,
    "BatchSize": 10,
    "MaxRetryCount": 3
  },
  "AllowedHosts": "*"
}