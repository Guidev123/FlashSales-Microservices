{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": ""
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "FlashSales.Orders.Api"
    }
  },
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Authentication": {
    "Authority": "",
    "Audience": "",
    "RequireHttpsMetadata": true,
    "MetadataAddress": ""
  },
  "ServiceBus": {
    "FullyQualifiedNamespace": "",
    "ConnectionString": ""
  },
  "Orders": {
    "Outbox": {
      "IntervalInSeconds": 5,
      "BatchSize": 10,
      "MaxRetryCount": 3
    },
    "Inbox": {
      "IntervalInSeconds": 5,
      "BatchSize": 10,
      "MaxRetryCount": 3
    },
    "Jobs": {
      "ExpirationSweepIntervalInSeconds": 30,
      "SagaSweepIntervalInSeconds": 30,
      "SagaStaleAfterSeconds": 60
    }
  },
  "AllowedHosts": "*"
}
